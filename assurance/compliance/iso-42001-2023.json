  "scopeLimitations": {
    "capability": "Current public, read-only WizardGang MCP capability and the application controls governing its tools, permissions, data, logging, evaluation, change, suppliers, and operation.",
    "modelBoundary": "WizardGang does not develop or control a general-purpose AI model in this scope and does not treat provider reasoning, memory, prompt handling, or internal controls as WizardGang-operated controls.",
    "approvedAiMcpFamilies": [
      "OpenAI Codex",
      "Anthropic Claude"
    ],
    "publicMcpDataBoundary": {
      "allowedD1Source": "demo_records",
      "excluded": [
        "visitor/session data",
        "identity data",
        "logs",
        "audit records",
        "R2 objects",
        "secrets"
      ]
    },
    "changeReviewRequiredFor": [
      "write authority",
      "privileged authority",
      "destructive authority",
      "deployment authority",
      "private-data access",
      "autonomous authority",
      "third-provider use",
      "reduced human oversight"
    ],
    "requiredReviewDomains": [
      "supplier",
      "risk",
      "impact",
      "SoA",
      "data",
      "testing"
    ],
    "trainingBoundary": "No model training, fine-tuning, labeling, or model-enhancement pipeline is in scope."
  },
