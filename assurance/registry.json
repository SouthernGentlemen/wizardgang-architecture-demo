{
  "schemaVersion": 1,
  "id": "wizardgang-public-assurance",
  "title": "WizardGang Architecture Demo Public Assurance Registry",
  "scope": "Public, disclosure-safe assurance records for demo.wizardgang.ai",
  "qualification": "Alignment and engineering evidence only; no certification is claimed.",
  "visibility": "public",
  "routes": { "api": "/v1/assurance" },
  "reporting": {
    "contract": "contracts/assurance/reporting.schema.json",
    "structuredRecords": {
      "id": "github.structured-records",
      "provider": "github",
      "authority": "structured-record",
      "repository": "SouthernGentlemen/wizardgang-architecture-demo",
      "resourceRoot": "assurance/",
      "nativeIdentity": ["repository", "resource"],
      "revisionIdentity": ["commit", "blob"],
      "capabilities": ["read", "query", "export", "import"],
      "ingestion": "enabled"
    },
    "retainedReports": {
      "id": "github.retained-reports",
      "provider": "github",
      "authority": "structured-record",
      "scope": {
        "repository": "SouthernGentlemen/wizardgang-architecture-demo",
        "branch": "assurance-reports",
        "resource": "reports/"
      },
      "nativeIdentity": ["repository", "reportId"],
      "revisionIdentity": ["branch", "blob"],
      "schema": "contracts/assurance/report.schema.json",
      "visibility": "public",
      "capabilities": ["read", "query", "export"],
      "ingestion": "disabled",
      "retention": {
        "mode": "git-history",
        "minimumDays": 400,
        "transportDays": 30,
        "deletion": "controlled-change"
      }
    },
    "nativeObjects": [
      {
        "id": "github.repositories", "provider": "github", "authority": "native-object",
        "scope": { "resource": "repositories" },
        "nativeIdentity": ["repositoryId"], "revisionIdentity": ["updatedAt", "pushedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.branches", "provider": "github", "authority": "native-object",
        "scope": { "resource": "branches" },
        "nativeIdentity": ["repository", "name"], "revisionIdentity": ["commitSha"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.commits", "provider": "github", "authority": "native-object",
        "scope": { "resource": "commits" },
        "nativeIdentity": ["repository", "sha"], "revisionIdentity": ["sha"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.issues", "provider": "github", "authority": "native-object",
        "scope": { "resource": "issues" },
        "nativeIdentity": ["repository", "number"], "revisionIdentity": ["updatedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export", "import"], "ingestion": "enabled"
      },
      {
        "id": "github.pull-requests", "provider": "github", "authority": "native-object",
        "scope": { "resource": "pull-requests" },
        "nativeIdentity": ["repository", "number"], "revisionIdentity": ["headSha", "updatedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.workflow-runs", "provider": "github", "authority": "native-object",
        "scope": { "resource": "workflow-runs" },
        "nativeIdentity": ["repository", "id"], "revisionIdentity": ["runAttempt", "updatedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.workflow-attempts", "provider": "github", "authority": "native-object",
        "scope": { "resource": "workflow-attempts" },
        "nativeIdentity": ["repository", "id", "runAttempt"], "revisionIdentity": ["updatedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.workflow-artifacts", "provider": "github", "authority": "native-object",
        "scope": { "resource": "workflow-artifacts" },
        "nativeIdentity": ["repository", "id"], "revisionIdentity": ["updatedAt", "expiresAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.tags", "provider": "github", "authority": "native-object",
        "scope": { "resource": "tags" },
        "nativeIdentity": ["repository", "name"], "revisionIdentity": ["commitSha"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.releases", "provider": "github", "authority": "native-object",
        "scope": { "resource": "releases" },
        "nativeIdentity": ["repository", "id"], "revisionIdentity": ["updatedAt", "tagName"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      },
      {
        "id": "github.branch-protection", "provider": "github", "authority": "native-object",
        "scope": { "resource": "branch-protection" },
        "nativeIdentity": ["repository", "branch"], "revisionIdentity": ["branchCommitSha"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "public",
        "capabilities": ["read", "query", "export"], "ingestion": "enabled"
      }
    ],
    "observations": [
      {
        "id": "cloudflare.operations",
        "provider": "cloudflare",
        "authority": "native-observation",
        "scope": { "resource": "account-operational-observations" },
        "nativeIdentity": ["resource"],
        "observationIdentity": ["resource", "metric", "dimensions", "window.start", "window.end"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/observation",
        "visibility": "public",
        "capabilities": ["read", "query", "export", "observe"],
        "ingestion": "enabled"
      }
    ],
    "privateSources": [
      {
        "id": "github.code-scanning-alerts", "provider": "github", "authority": "native-object",
        "scope": { "resource": "code-scanning-alerts" },
        "nativeIdentity": ["repository", "number"], "revisionIdentity": ["updatedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "private",
        "capabilities": ["read", "query", "export"], "ingestion": "disabled"
      },
      {
        "id": "github.secret-scanning-alerts", "provider": "github", "authority": "native-object",
        "scope": { "resource": "secret-scanning-alerts" },
        "nativeIdentity": ["repository", "number"], "revisionIdentity": ["updatedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "private",
        "capabilities": ["read", "query", "export"], "ingestion": "disabled"
      },
      {
        "id": "github.dependabot-alerts", "provider": "github", "authority": "native-object",
        "scope": { "resource": "dependabot-alerts" },
        "nativeIdentity": ["repository", "number"], "revisionIdentity": ["updatedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "private",
        "capabilities": ["read", "query", "export"], "ingestion": "disabled"
      },
      {
        "id": "github.repository-security-advisories", "provider": "github", "authority": "native-object",
        "scope": { "resource": "repository-security-advisories" },
        "nativeIdentity": ["repository", "ghsaId"], "revisionIdentity": ["updatedAt"],
        "schema": "contracts/assurance/reporting.schema.json#/$defs/record", "visibility": "private",
        "capabilities": ["read", "query", "export"], "ingestion": "disabled"
      }
    ],
    "ownership": [
      { "domain": "evidence", "source": "github.structured-records", "resource": "evidence" },
      { "domain": "reports", "source": "github.retained-reports" },
      { "domain": "issues", "source": "github.issues" },
      { "domain": "risks", "source": "github.structured-records", "resource": "risks" },
      { "domain": "security", "source": "github.structured-records", "resource": "advisories" },
      { "domain": "governance", "source": "github.structured-records", "resource": "governance.records" },
      { "domain": "operations", "source": "cloudflare.operations" }
    ],
    "privateIngestion": "disabled"
  },
  "lifecycle": {
    "id": "lifecycle.records", "kind": "lifecycle", "role": "control-plane",
    "path": "assurance/lifecycle/records.json", "schema": "contracts/assurance/lifecycle.schema.json",
    "visibility": "public", "capabilities": ["runtime", "lifecycle"]
  },
  "datasets": [
    {
      "id": "evidence", "kind": "evidence", "role": "dataset",
      "path": "assurance/evidence/evidence.json", "schema": "contracts/assurance/evidence.schema.json",
      "visibility": "public", "capabilities": ["runtime", "records", "api-index"],
      "recordCollection": { "path": "records", "identity": ["kind", "locator.repositoryPath", "locator.route"] },
      "routes": { "html": "/evidence", "api": "/v1/assurance/evidence", "aliases": [{ "path": "/traceability", "fragment": "traceability" }] }
    },
    {
      "id": "claims", "kind": "claims", "role": "dataset",
      "path": "assurance/claims/claims.json", "schema": "contracts/assurance/claim.schema.json",
      "visibility": "public", "capabilities": ["runtime", "records", "api-index"],
      "recordCollection": { "path": "records", "identity": ["area", "title"] }
    },
    {
      "id": "objectives", "kind": "objectives", "role": "dataset",
      "path": "assurance/objectives/objectives.json", "schema": "contracts/assurance/objective.schema.json",
      "visibility": "public", "capabilities": ["runtime", "records", "summary-source"],
      "recordCollection": { "path": "records", "identity": ["area", "objective"] }
    },
    {
      "id": "compliance.iso-27001", "kind": "compliance", "role": "dataset",
      "path": "assurance/compliance/iso-27001-2022.json", "schema": "contracts/assurance/iso-27001-compliance.schema.json",
      "visibility": "public", "capabilities": ["runtime", "records", "api-index", "summary-source"],
      "recordCollection": { "path": "records", "identity": [{ "source": "resource", "path": "framework.id" }, { "source": "record", "path": "reference" }] },
      "qualification": "Public engineering-evidence projection only. Framework-specific qualifications remain authoritative; certification and formal conformance are not claimed.",
      "routes": { "html": "/compliance", "api": "/v1/assurance/compliance", "apiRecord": "/v1/assurance/compliance/{id}" },
      "filters": {
        "framework": { "path": "framework", "label": "Framework" },
        "status": { "path": "status", "label": "Status" },
        "level": { "path": "level", "label": "WCAG level" }
      },
      "resources": [
        {
          "id": "compliance.iso-42001", "kind": "compliance", "role": "dataset",
          "path": "assurance/compliance/iso-42001-2023.json", "schema": "contracts/assurance/iso-42001-compliance.schema.json",
          "visibility": "public", "capabilities": ["runtime", "records", "summary-source"],
          "recordCollection": { "path": "records", "identity": [{ "source": "resource", "path": "framework.id" }, { "source": "record", "path": "reference" }] },
          "framework": {
            "id": "iso-42001", "label": "ISO/IEC 42001:2023", "edition": "2023",
            "qualification": "Public alignment and engineering-evidence mapping only; independent certification or formal conformance is not claimed.",
            "assessmentDate": "2026-09-02"
          }
        },
        {
          "id": "compliance.wcag-2.2", "kind": "compliance", "role": "dataset",
          "path": "assurance/compliance/wcag-2.2.json", "schema": "contracts/assurance/wcag-2.2-registry.schema.json",
          "visibility": "public", "capabilities": ["runtime", "manifest"],
          "framework": {
            "id": "wcag-2.2", "label": "WCAG 2.2", "edition": "2.2",
            "qualification": "This registry does not claim WCAG 2.2 conformance at Level A, AA, or AAA, certification, or that any full page satisfies a WCAG conformance level.",
            "assessmentDate": "2026-09-02"
          },
          "resources": [
            {
              "id": "compliance.wcag-2.2.perceivable", "kind": "compliance", "role": "partition",
              "path": "assurance/compliance/wcag-2.2/perceivable.json", "schema": "contracts/assurance/wcag-2.2-criteria.schema.json",
              "visibility": "public", "capabilities": ["runtime", "records"],
              "recordCollection": { "path": "criteria", "identity": [{ "source": "resource", "path": "framework.id" }, { "source": "record", "path": "reference" }] },
              "partition": { "number": "1", "label": "Perceivable" }
            },
            {
              "id": "compliance.wcag-2.2.operable", "kind": "compliance", "role": "partition",
              "path": "assurance/compliance/wcag-2.2/operable.json", "schema": "contracts/assurance/wcag-2.2-criteria.schema.json",
              "visibility": "public", "capabilities": ["runtime", "records"],
              "recordCollection": { "path": "criteria", "identity": [{ "source": "resource", "path": "framework.id" }, { "source": "record", "path": "reference" }] },
              "partition": { "number": "2", "label": "Operable" }
            },
            {
              "id": "compliance.wcag-2.2.understandable", "kind": "compliance", "role": "partition",
              "path": "assurance/compliance/wcag-2.2/understandable.json", "schema": "contracts/assurance/wcag-2.2-criteria.schema.json",
              "visibility": "public", "capabilities": ["runtime", "records"],
              "recordCollection": { "path": "criteria", "identity": [{ "source": "resource", "path": "framework.id" }, { "source": "record", "path": "reference" }] },
              "partition": { "number": "3", "label": "Understandable" }
            },
            {
              "id": "compliance.wcag-2.2.robust", "kind": "compliance", "role": "partition",
              "path": "assurance/compliance/wcag-2.2/robust.json", "schema": "contracts/assurance/wcag-2.2-criteria.schema.json",
              "visibility": "public", "capabilities": ["runtime", "records"],
              "recordCollection": { "path": "criteria", "identity": [{ "source": "resource", "path": "framework.id" }, { "source": "record", "path": "reference" }] },
              "partition": { "number": "4", "label": "Robust" }
            }
          ]
        }
      ],
      "framework": {
        "id": "iso-27001", "label": "ISO/IEC 27001:2022", "edition": "2022",
        "qualification": "Public alignment and engineering-evidence mapping only; independent certification or formal conformance is not claimed.",
        "assessmentDate": "2026-09-02"
      }
    },
    {
      "id": "governance.records", "kind": "governance-records", "role": "dataset",
      "path": "assurance/governance/asset-inventory.json", "schema": "contracts/assurance/governance-record.schema.json",
      "visibility": "public", "capabilities": ["summary-source"],
      "qualification": "Reportable governance register facts are canonical structured records; generated Markdown remains a presentation layer and policy prose remains authored in Markdown.",
      "resources": [
        {
          "id": "governance.records.access-classes", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/access-classes.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.access-reviews", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/access-reviews.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.competence", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/competence.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.awareness", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/awareness.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.configuration", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/configuration.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.cryptography-secrets", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/cryptography-secrets.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.data-inventory", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/data-inventory.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.data-retention", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/data-retention.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.obligations", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/obligations.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.recovery-tests", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/recovery-tests.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.security-maintenance", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/security-maintenance.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.security-testing", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/security-testing.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        },
        {
          "id": "governance.records.suppliers", "kind": "governance-records", "role": "partition",
          "path": "assurance/governance/suppliers.json", "schema": "contracts/assurance/governance-record.schema.json",
          "visibility": "public", "capabilities": ["summary-source"]
        }
      ]
    },
    {
      "id": "risks", "kind": "risks", "role": "dataset",
      "path": "assurance/risks/risks.json", "schema": "contracts/assurance/risk.schema.json",
      "visibility": "public", "capabilities": ["runtime", "records", "api-index"],
      "recordCollection": { "path": "records", "identity": ["framework", "title"] },
      "routes": { "html": "/governance/risks", "api": "/v1/assurance/risks" },
      "filters": {
        "framework": { "path": "framework", "label": "Framework" },
        "status": { "path": "status", "label": "Status" },
        "residual": { "path": "residual.rating", "label": "Residual rating" }
      }
    },
    {
      "id": "incidents", "kind": "incidents", "role": "dataset",
      "path": "assurance/incidents/incidents.json", "schema": "contracts/assurance/incident.schema.json",
      "visibility": "public", "capabilities": ["runtime", "records", "api-index"],
      "recordCollection": { "path": "records", "identity": ["recordType", "detectedAt", "title"] },
      "routes": { "html": "/governance/incidents", "api": "/v1/assurance/incidents" }
    },
    {
      "id": "exercises", "kind": "exercises", "role": "dataset",
      "path": "assurance/incidents/exercises.json", "schema": "contracts/assurance/exercise.schema.json",
      "visibility": "public", "capabilities": ["runtime", "records", "api-index"],
      "recordCollection": { "path": "records", "identity": ["recordType", "exerciseType", "scenario"] },
      "routeOwner": "incidents"
    },
    {
      "id": "advisories", "kind": "advisories", "role": "dataset",
      "path": "assurance/advisories/advisories.json", "schema": "contracts/assurance/advisory.schema.json",
      "visibility": "public", "capabilities": ["runtime", "records", "api-index"],
      "recordCollection": { "path": "records", "identity": ["recordType", "publishedAt"] },
      "routes": { "html": "/security", "api": "/v1/assurance/advisories" }
    }
  ],
  "presentations": [
    {
      "id": "presentation.documents", "kind": "documents", "role": "presentation",
      "path": "assurance/presentation/documents.json", "schema": "contracts/assurance/presentation-document.schema.json",
      "visibility": "public", "capabilities": ["summary-source"]
    }
  ],
  "operations": [
    {
      "id": "operations.monitoring", "kind": "operations", "role": "operations",
      "path": "assurance/operations/monitoring.json", "schema": "contracts/assurance/operations.schema.json",
      "visibility": "public", "capabilities": ["monitoring"]
    }
  ]
}
