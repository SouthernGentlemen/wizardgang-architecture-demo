{
  "schemaVersion": 1,
  "repository": "SouthernGentlemen/wizardgang-architecture-demo",
  "repositorySettings": {
    "allowMergeCommit": true,
    "allowSquashMerge": false,
    "allowRebaseMerge": false,
    "deleteBranchOnMerge": true
  },
  "rulesets": [
    {
      "name": "Protect main",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "include": [
          "refs/heads/main"
        ],
        "exclude": []
      },
      "bypassActors": [],
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "non_fast_forward"
        },
        {
          "type": "pull_request",
          "parameters": {
            "requiredApprovingReviewCount": 0,
            "allowedMergeMethods": [
              "merge"
            ]
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "requiredStatusChecks": [
              "change-id",
              "validate"
            ]
          }
        }
      ]
    },
    {
      "name": "Protect release tags",
      "target": "tag",
      "enforcement": "active",
      "conditions": {
        "include": [
          "refs/tags/v*"
        ],
        "exclude": []
      },
      "bypassActors": [],
      "rules": [
        {
          "type": "deletion"
        },
        {
          "type": "update"
        }
      ]
    }
  ]
}
