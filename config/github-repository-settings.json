{
  "repository": "SouthernGentlemen/wizardgang-architecture-demo",
  "defaultBranch": "main",
  "mergeMethods": { "mergeCommit": false, "squash": true, "rebase": false },
  "deleteBranchOnMerge": true,
  "rulesets": {
    "main": {
      "name": "Protect main",
      "target": "branch",
      "enforcement": "active",
      "include": ["refs/heads/main"],
      "exclude": [],
      "bypassActors": [],
      "requireBranchUpToDate": true,
      "requireExtraApprovalForUnattributedChanges": true,
      "requiredReviewThreadResolution": false,
      "doNotEnforceOnCreate": false,
      "requiredRules": ["deletion", "non_fast_forward", "pull_request", "required_status_checks"],
      "requiredStatusChecks": ["validate", "change-id"]
    },
    "releaseTags": {
      "name": "Protect release tags",
      "target": "tag",
      "enforcement": "active",
      "include": ["refs/tags/v*"],
      "exclude": [],
      "bypassActors": [],
      "requiredRules": ["deletion", "update"]
    }
  }
}
