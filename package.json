{
  "name": "wizardgang-architecture-demo",
  "version": "0.31.1",
  "private": false,
  "type": "module",
  "imports": {
    "#wg-edge": {
      "types": "./platform/wg-edge/index.d.ts",
      "default": "./platform/wg-edge/index.mjs"
    }
  },
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.1.0",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false,
    "workerd@1.20260926.1": true
  },
  "scripts": {
    "dev": "node scripts/generate-worker-entry.ts && npm run generate:assets && node scripts/dev.ts",
    "deploy": "node scripts/refuse-production-deploy.ts",
    "generate:assets": "ASSET_MANIFEST_WRITE=1 vite build",
    "validate:assets": "vite build",
    "build:client": "npm run generate:assets",
    "build:worker": "node scripts/generate-worker-entry.ts && wrangler deploy --dry-run --outdir dist/worker && npm run validate:worker-bundle",
    "build": "npm run build:client && npm run build:worker",
    "lint": "node scripts/lint.ts",
    "typecheck": "tsc --noEmit && tsc --project src/browser/tsconfig.json --noEmit",
    "validate:typescript-execution": "node scripts/validate-typescript-execution.ts --self-check",
    "test": "vitest run",
    "test:accessibility": "vitest run tests/interface.test.ts tests/wcag-aaa-remediation.test.ts",
    "test:site-accessibility": "npm run verify:chromium && node scripts/run-site-accessibility-audits.ts",
    "validate:site-accessibility": "vitest run tests/site-accessibility-i18n.test.ts -t \"site-wide accessibility\"",
    "validate:site-i18n": "vitest run tests/site-accessibility-i18n.test.ts -t \"site-wide localization\"",
    "test:assurance-integrity": "vitest run tests/assurance-integrity.test.ts tests/assurance-semantic-partitions.test.ts tests/assurance-lifecycle.test.ts tests/assurance-publication-policy.test.ts tests/assurance-presentation-consistency.test.ts tests/assurance-registry-completeness.test.ts tests/assurance-record-discovery.test.ts",
    "generate:openapi": "node scripts/sync-openapi-schemas.ts",
    "validate:contracts": "node scripts/sync-openapi-schemas.ts --check && node scripts/validate-contracts.ts",
    "validate:locales": "node scripts/validate-locales.ts",
    "validate:history": "node scripts/validate-history.ts",
    "validate:implementation-plan": "node scripts/validate-implementation-plan.ts",
    "validate:governance": "node scripts/validate-governance-metadata.ts",
    "validate:wcag": "node scripts/validate-wcag-compliance.ts",
    "generate:assurance-runtime-binding": "node scripts/generate-assurance-runtime-binding.ts",
    "validate:assurance-runtime-binding": "node scripts/generate-assurance-runtime-binding.ts --check",
    "validate:generated-artifacts": "node scripts/validate-generated-artifacts.ts",
    "validate:assurance-operations": "node scripts/validate-assurance-operations.ts",
    "monitor:assurance": "node scripts/validate-assurance-operations.ts --live",
    "snapshot:assurance": "node scripts/generate-assurance-snapshot.ts",
    "validate:assurance": "node scripts/validate-assurance-registry.ts && npm run validate:assurance-runtime-binding && node scripts/validate-assurance.ts && node scripts/validate-advisories.ts && node scripts/validate-assurance-projection.ts && npm run validate:assurance-documentation && node scripts/validate-iso27001-compliance.ts && node scripts/validate-iso42001-compliance.ts && node scripts/validate-wcag-compliance.ts && npm run validate:assurance-publication && node scripts/validate-assurance-lifecycle.ts && node scripts/validate-assurance-integrity.ts && npm run validate:assurance-operations",
    "validate:assurance-publication": "node scripts/validate-assurance-publication.ts",
    "validate:migrations": "node scripts/validate-migrations.ts",
    "verify:chromium": "node scripts/verify-chromium.ts",
    "validate:ci": "node scripts/ci-validation.ts",
    "validate:pull-request-identity": "node scripts/validate-pull-request-identity.ts",
    "validate:security": "node scripts/validate-security.ts",
    "generate:routes": "ROUTE_ARTIFACTS_WRITE=1 vitest run tests/route-artifacts.test.ts",
    "validate:routes": "vitest run tests/route-artifacts.test.ts",
    "validate:stylesheet-classes": "node scripts/validate-stylesheet-classes.ts",
    "validate:react-presentation": "node scripts/validate-react-presentation.ts",
    "validate:worker-bundle": "node scripts/validate-react-presentation.ts --worker-bundle",
    "validate:repository-baseline": "node scripts/validate-repository-baseline.ts",
    "validate:patch-whitespace": "node scripts/validate-patch-whitespace.ts",
    "security:dependency-advisories": "npm audit --audit-level=high",
    "audit:dependencies": "npm run security:dependency-advisories",
    "check": "npm run validate:typescript-execution && npm run check:platform && npm run test:plan-queue && npm run validate:generated-artifacts && npm run validate:migrations && npm run build && npm run validate:scaffold && npm run validate:history && npm run validate:implementation-plan && npm run validate:worker-secrets && npm run validate:repository-settings && npm run test:github-settings && npm run validate:repository-baseline && npm run validate:react-presentation && npm run validate:stylesheet-classes && npm run lint && npm run typecheck && npm run test:site-accessibility && npm run test && npm run validate:contracts && npm run validate:locales && npm run validate:security && npm run validate:governance && npm run validate:documentation && npm run validate:assurance",
    "validate:scaffold": "node scripts/validate-scaffold.ts",
    "validate:assurance-documentation": "node scripts/validate-assurance-documentation.ts",
    "validate:worker-secrets": "node scripts/validate-worker-secrets.ts",
    "check:platform": "node platform/conformance/cli.mjs pin && node platform/conformance/cli.mjs wrangler --worker demo",
    "validate:repository-settings": "node scripts/validate-github-repository-settings.ts",
    "test:plan-queue": "node scripts/check-portfolio-contract.ts",
    "test:github-settings": "node --test tests/github-settings.cases.mjs",
    "verify:github-settings": "node scripts/verify-github-settings.ts",
    "apply:github-settings": "node scripts/apply-github-settings.ts",
    "provision:worker-secret": "node scripts/provision-worker-secret.ts",
    "validate:documentation": "node scripts/validate-documentation-cleanup.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.5",
    "oxc-parser": "^0.150.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.144.0"
  },
  "dependencies": {
    "@graphql-yoga/graphiql": "^4.5.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@node-saml/node-saml": "^5.1.0",
    "@xmldom/xmldom": "^0.8.15",
    "axe-core": "^4.13.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.22.0",
    "jose": "^6.2.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "@graphql-tools/utils": "12.0.3",
    "@graphql-tools/executor-legacy-ws": "1.1.37",
    "source-map-js": "1.2.2"
  }
}
