{
  "name": "wizardgang-architecture-demo",
  "version": "0.26.0",
  "private": false,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:accessibility": "vitest run tests/interface.test.ts tests/wcag-aaa-remediation.test.ts",
    "test:site-accessibility": "node scripts/run-site-accessibility-audits.mjs",
    "validate:site-accessibility": "vitest run tests/site-accessibility-i18n.test.ts -t \"site-wide accessibility\"",
    "validate:site-i18n": "vitest run tests/site-accessibility-i18n.test.ts -t \"site-wide localization\"",
    "test:assurance-integrity": "vitest run tests/assurance-integrity.test.ts tests/assurance-semantic-partitions.test.ts tests/assurance-lifecycle.test.ts tests/assurance-publication-policy.test.ts tests/assurance-presentation-consistency.test.ts tests/assurance-registry-completeness.test.ts tests/assurance-record-discovery.test.ts",
    "generate:openapi": "node scripts/sync-openapi-schemas.mjs",
    "validate:contracts": "node scripts/sync-openapi-schemas.mjs --check && node scripts/validate-contracts.mjs",
    "validate:locales": "node scripts/validate-locales.mjs",
    "validate:history": "node scripts/validate-history.mjs",
    "validate:governance": "node scripts/validate-governance-metadata.mjs",
    "validate:wcag": "node scripts/validate-wcag-compliance.mjs",
    "generate:assurance-runtime-binding": "node scripts/generate-assurance-runtime-binding.mjs",
    "validate:assurance-runtime-binding": "node scripts/generate-assurance-runtime-binding.mjs --check",
    "validate:generated-artifacts": "node scripts/validate-generated-artifacts.mjs",
    "validate:assurance-operations": "node scripts/validate-assurance-operations.mjs",
    "monitor:assurance": "node scripts/validate-assurance-operations.mjs --live",
    "snapshot:assurance": "node scripts/generate-assurance-snapshot.mjs",
    "validate:assurance": "node scripts/validate-assurance-registry.mjs && npm run validate:assurance-runtime-binding && node scripts/validate-assurance.mjs && node scripts/validate-advisories.mjs && node scripts/validate-assurance-projection.mjs && npm run validate:assurance-documentation && node scripts/validate-iso27001-compliance.mjs && node scripts/validate-iso42001-compliance.mjs && node scripts/validate-wcag-compliance.mjs && npm run validate:assurance-publication && node scripts/validate-assurance-lifecycle.mjs && node scripts/validate-assurance-integrity.mjs && npm run validate:assurance-operations",
    "validate:assurance-publication": "node scripts/validate-assurance-publication.mjs",
    "validate:migrations": "wrangler d1 migrations apply demo-blob --local",
    "verify:chromium": "node scripts/verify-chromium.mjs",
    "validate:ci": "node scripts/ci-validation.mjs",
    "validate:security": "node scripts/validate-security.mjs",
    "generate:routes": "ROUTE_ARTIFACTS_WRITE=1 vitest run tests/route-artifacts.test.ts",
    "validate:routes": "vitest run tests/route-artifacts.test.ts",
    "validate:stylesheet-classes": "node scripts/validate-stylesheet-classes.mjs",
    "security:dependencies": "npm audit --audit-level=high",
    "check": "npm run validate:routes && npm run validate:scaffold && npm run validate:history && npm run validate:worker-secrets && npm run validate:repository-settings && npm run validate:stylesheet-classes && npm run lint && npm run typecheck && npm run validate:site-accessibility && npm run validate:site-i18n && npm run test && npm run validate:contracts && npm run validate:locales && npm run validate:security && npm run validate:governance && npm run validate:documentation && npm run validate:assurance",
    "validate:scaffold": "node scripts/validate-scaffold.mjs",
    "validate:assurance-documentation": "node scripts/validate-assurance-documentation.mjs",
    "validate:worker-secrets": "node scripts/validate-worker-secrets.mjs",
    "validate:repository-settings": "node scripts/validate-github-repository-settings.mjs",
    "provision:worker-secret": "node scripts/provision-worker-secret.mjs",
    "validate:documentation": "node scripts/validate-documentation-cleanup.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "@graphql-yoga/graphiql": "^4.5.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@node-saml/node-saml": "^5.1.0",
    "@xmldom/xmldom": "^0.8.15",
    "axe-core": "^4.13.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.22.0",
    "jose": "^6.2.10",
    "zod": "^4.5.4"
  },
  "overrides": {
    "sharp": "^0.35.4"
  }
}
