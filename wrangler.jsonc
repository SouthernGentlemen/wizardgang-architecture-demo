{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wizardgang-architecture-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "demo.wizardgang.ai", "custom_domain": true }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Worker secrets (config/worker-secrets.json) are set with `wrangler secret put` from baseline docs/SECRETS-RUNBOOK.md;
  // never commit their values. The OAuth client IDs, the Entra tenant and the SAML IdP values are public and live here.
  // SAML_IDP_CERT, SAML_IDP_ISSUER and SAML_SSO_URL are added once the Entra wg-saml-idp app exists; SAML fails closed until then.
  "vars": {
    "GITHUB_REPO_URL": "https://github.com/Wizard-Gang/wizardgang-architecture-demo",
    "GITHUB_BRANCH": "main",
    "DEPLOYED_VERSION": "development",
    "DEPLOYMENT_ENVIRONMENT": "production",
    "DEPLOYMENT_CI_STATUS": "not-verified",
    "BILLING_DEMO_MONTHLY_BUDGET_USD": "10",
    "CLOUDFLARE_WORKER_NAME": "wizardgang-architecture-demo",
    "CLOUDFLARE_R2_BUCKET": "wizardgang",
    "CLOUDFLARE_D1_DATABASE_ID": "95524076-8432-4d4a-b3ab-1a11ede73d4f",
    "CLOUDFLARE_DO_NAMESPACE": "2a8431fd59b342799b74518e1bcc7b6d",
    "GITHUB_APP_ID": "5200141",
    "GITHUB_APP_INSTALLATION_ID": "168238365",
    "GITHUB_OAUTH_CLIENT_ID": "Ov23lizi50EUG1CVLmrY",
    "GOOGLE_OAUTH_CLIENT_ID": "681291327254-o04025q9gibvdnqcc61qui404nnmn7rn.apps.googleusercontent.com",
    "MICROSOFT_OAUTH_CLIENT_ID": "d5706222-8cbb-4072-91a4-02715973f26d",
    "MICROSOFT_TENANT_ID": "dc4e17d6-aa5b-46d9-8a74-4fbc4d7dd5b8"
  },
  // The shared Secrets Store root key. wg-edge derives demo-session, identity-session and identity-audit from it.
  "secrets_store_secrets": [
    { "binding": "WG_SESSION_KEY", "store_id": "e63e666172544d5c8c4a656ff28ac32a", "secret_name": "WG_SESSION_KEY" }
  ],
  // Baseline's shared D1 and R2. The demo reads and writes only its own records/events rows (app 'demo') and objects
  // under demo/; baseline owns the schema (platform/migrations), so there is no migrations_dir. wrangler 4.147 cannot
  // bind a D1 by name with provisioning off, so the UUID is committed.
  "d1_databases": [
    {
      "binding": "WG_DB",
      "database_name": "wizardgang",
      "database_id": "95524076-8432-4d4a-b3ab-1a11ede73d4f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "WG_R2",
      "bucket_name": "wizardgang"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO_COORDINATOR",
        "class_name": "DemoCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "do-v1",
      "new_sqlite_classes": ["DemoCoordinator"]
    }
  ]
}
