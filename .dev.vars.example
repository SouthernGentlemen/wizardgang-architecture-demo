# Copy to .dev.vars for local development. Never commit real credentials.
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=replace-me-with-a-local-only-value
DEMO_API_TOKEN=replace-me-with-a-local-only-api-token
WEBHOOK_DEMO_SECRET=replace-me-with-a-local-only-webhook-secret
GITHUB_WEBHOOK_SECRET=replace-me-with-a-local-only-github-webhook-secret
DEMO_SESSION_SECRET=replace-me-with-at-least-32-local-only-characters

# Optional protected GitHub reporting. Public repositories use the anonymous GitHub API by default.
# GITHUB_READ_TOKEN is a dedicated fine-grained read credential for configured private repositories
# and protected security sources. Keep it server-side and repository-scoped.
# GITHUB_READ_TOKEN=replace-me-with-a-local-only-read-token
# GITHUB_REPORTING_BINDINGS=[{"repository":"SouthernGentlemen/wizardgang-architecture-demo","sources":["github.issues","github.workflow-runs"],"issueLabels":["corrective-action"]}]
# GITHUB_REPORTING_MAX_PAGES=20
# Native reporting writes are opt-in and currently support update-only GitHub issues.
# Use a separate fine-grained Issues: write credential; the live Git demo token is not reused.
# GITHUB_REPORTING_WRITE_TOKEN=replace-me-with-a-local-only-issues-write-token

# Real identity providers. Register localhost callback URLs separately for local testing.
IDENTITY_SESSION_SECRET=replace-me-with-at-least-32-local-only-characters
MICROSOFT_CLIENT_ID=replace-me
MICROSOFT_CLIENT_SECRET=replace-me
MICROSOFT_TENANT_ID=replace-me
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
SAML_IDP_CERT=replace-me-with-the-entra-signing-certificate
# Optional overrides; defaults are derived from MICROSOFT_TENANT_ID.
# SAML_IDP_ISSUER=https://sts.windows.net/replace-me/
# SAML_SSO_URL=https://login.microsoftonline.com/replace-me/saml2

# Optional live operations telemetry. Use a dedicated minimum-permission read token.
# CLOUDFLARE_ACCOUNT_ID=replace-me
# CLOUDFLARE_API_TOKEN=replace-me-with-analytics-read-and-optional-billing-read
# CLOUDFLARE_WORKER_NAME=wizardgang-architecture-demo
# CLOUDFLARE_D1_DATABASE_ID=replace-me
# CLOUDFLARE_R2_BUCKET=wizardgang-demo-r2
# CLOUDFLARE_DO_NAMESPACE=replace-me
