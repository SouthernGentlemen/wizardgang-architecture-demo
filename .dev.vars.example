# Copy to .dev.vars for local development. Never commit real credentials.
# Worker secret names in this block must match config/worker-secrets.json.
# WORKER_SECRETS_START
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=replace-me-with-a-local-only-value
DEMO_WEBHOOK_SECRET=replace-me-with-a-local-only-webhook-secret
GITHUB_WEBHOOK_SECRET=replace-me-with-a-local-only-github-webhook-secret
GITHUB_APP_PRIVATE_KEY=replace-me-with-a-local-only-pkcs8-key
GITHUB_OAUTH_CLIENT_SECRET=replace-me
GOOGLE_OAUTH_CLIENT_SECRET=replace-me
MICROSOFT_OAUTH_CLIENT_SECRET=replace-me

# Optional managed Worker secrets.
# CLOUDFLARE_BILLING_TOKEN=replace-me-with-account-analytics-read-and-billing-read
# WORKER_SECRETS_END

# Sessions and identity derive their keys from the Secrets Store binding WG_SESSION_KEY (see wrangler.jsonc), which
# local development simulates. Seed the local store once with a local-only value of at least 32 characters:
#   npx wrangler secrets-store secret create e63e666172544d5c8c4a656ff28ac32a --name WG_SESSION_KEY --scopes workers

# Public provider configuration lives in wrangler.jsonc vars. Override it here only to test other provider clients.
# GITHUB_OAUTH_CLIENT_ID=replace-me
# GOOGLE_OAUTH_CLIENT_ID=replace-me
# MICROSOFT_OAUTH_CLIENT_ID=replace-me
# MICROSOFT_TENANT_ID=replace-me
# GITHUB_APP_ID=replace-me
# GITHUB_APP_INSTALLATION_ID=replace-me
# SAML_IDP_CERT=replace-me-with-the-entra-signing-certificate

# Optional protected GitHub reporting. Public repositories use the anonymous GitHub API by default.
# GITHUB_REPORTING_BINDINGS=[{"repository":"Wizard-Gang/wizardgang-architecture-demo","sources":["github.issues","github.workflow-runs"],"issueLabels":["corrective-action"]}]
# GITHUB_REPORTING_MAX_PAGES=20

# Optional SAML IdP values; without them the issuer and SSO URL default from MICROSOFT_TENANT_ID.
# SAML_IDP_ISSUER=https://sts.windows.net/replace-me/
# SAML_SSO_URL=https://login.microsoftonline.com/replace-me/saml2

# Optional live operations telemetry identifiers. The token itself is declared above.
# CLOUDFLARE_ACCOUNT_ID=replace-me
# CLOUDFLARE_WORKER_NAME=wizardgang-architecture-demo
# CLOUDFLARE_D1_DATABASE_ID=replace-me
# CLOUDFLARE_R2_BUCKET=wizardgang

# DEMO-186 canonical external endpoints. Provider-side settings are changed at release time, not by this file.
# Microsoft redirect URI: <PUBLIC_ORIGIN>/auth/microsoft/callback
# Google redirect URI: <PUBLIC_ORIGIN>/auth/google/callback
# GitHub OAuth callback URL: <PUBLIC_ORIGIN>/auth/github/callback
# SAML entity ID: <PUBLIC_ORIGIN>/auth/saml
# SAML ACS URL: <PUBLIC_ORIGIN>/auth/saml/acs
# SAML metadata URL: <PUBLIC_ORIGIN>/auth/saml/metadata
# GitHub webhook payload URL: <PUBLIC_ORIGIN>/webhooks/github
