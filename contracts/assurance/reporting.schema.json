{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/reporting.schema.json",
  "title": "Common Reporting Primitives",
  "type": "object",
  "$defs": {
    "capability": {
      "enum": ["read", "query", "export", "import", "observe"]
    },
    "visibility": {
      "enum": ["public", "private"]
    },
    "availability": {
      "enum": ["available", "partial", "unavailable", "rate-limited", "stale", "expired"]
    },
    "sourceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "authority", "scope", "nativeIdentity", "schema", "visibility", "capabilities", "ingestion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "provider": { "enum": ["github", "cloudflare"] },
        "authority": { "enum": ["native-object", "structured-record", "native-observation"] },
        "scope": { "$ref": "#/$defs/sourceScope" },
        "nativeIdentity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "revisionIdentity": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "observationIdentity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "schema": { "type": "string", "pattern": "^contracts/assurance/.+\\.schema\\.json(?:#/.+)?$" },
        "visibility": { "$ref": "#/$defs/visibility" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "ingestion": { "enum": ["enabled", "disabled"] }
      },
      "allOf": [
        {
          "if": { "properties": { "authority": { "const": "native-observation" } }, "required": ["authority"] },
          "then": { "required": ["observationIdentity"] }
        },
        {
          "if": { "properties": { "authority": { "enum": ["native-object", "structured-record"] } }, "required": ["authority"] },
          "then": {
            "required": ["revisionIdentity"],
            "properties": { "revisionIdentity": { "minItems": 1 } }
          }
        }
      ]
    },
    "structuredRecordSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "authority", "repository", "resourceRoot", "nativeIdentity", "revisionIdentity", "capabilities", "ingestion"],
      "properties": {
        "id": { "const": "github.structured-records" },
        "provider": { "const": "github" },
        "authority": { "const": "structured-record" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "resourceRoot": { "const": "assurance/" },
        "nativeIdentity": { "const": ["repository", "resource"] },
        "revisionIdentity": { "const": ["commit", "blob"] },
        "capabilities": { "const": ["read", "query", "export", "import"] },
        "ingestion": { "const": "enabled" }
      }
    },
    "retainedReportSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider", "authority", "scope", "nativeIdentity", "revisionIdentity", "schema", "visibility", "capabilities", "ingestion", "retention"],
      "properties": {
        "id": { "const": "github.retained-reports" },
        "provider": { "const": "github" },
        "authority": { "const": "structured-record" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "branch", "resource"],
          "properties": {
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
            "branch": { "const": "assurance-reports" },
            "resource": { "const": "reports/" }
          }
        },
        "nativeIdentity": { "const": ["repository", "reportId"] },
        "revisionIdentity": { "const": ["branch", "blob"] },
        "schema": { "const": "contracts/assurance/report.schema.json" },
        "visibility": { "const": "public" },
        "capabilities": { "const": ["read", "query", "export"] },
        "ingestion": { "const": "disabled" },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "minimumDays", "transportDays", "deletion"],
          "properties": {
            "mode": { "const": "git-history" },
            "minimumDays": { "type": "integer", "minimum": 400 },
            "transportDays": { "const": 30 },
            "deletion": { "const": "controlled-change" }
          }
        }
      }
    },
    "privateSource": {
      "allOf": [
        { "$ref": "#/$defs/source" },
        {
          "properties": {
            "visibility": { "const": "private" },
            "ingestion": { "const": "disabled" }
          }
        }
      ]
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "source"],
      "properties": {
        "domain": { "enum": ["evidence", "reports", "issues", "risks", "security", "governance", "operations"] },
        "source": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "resource": { "type": "string", "pattern": "^[a-z0-9.-]+$" }
      }
    },
    "registryReporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "structuredRecords", "retainedReports", "nativeObjects", "observations", "privateSources", "ownership", "privateIngestion"],
      "properties": {
        "contract": { "const": "contracts/assurance/reporting.schema.json" },
        "structuredRecords": { "$ref": "#/$defs/structuredRecordSource" },
        "retainedReports": { "$ref": "#/$defs/retainedReportSource" },
        "nativeObjects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/source" },
              {
                "properties": {
                  "provider": { "const": "github" },
                  "authority": { "const": "native-object" }
                }
              }
            ]
          }
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/source" },
              {
                "properties": {
                  "provider": { "const": "cloudflare" },
                  "authority": { "const": "native-observation" },
                  "observationIdentity": { "const": ["resource", "metric", "dimensions", "window.start", "window.end"] }
                }
              }
            ]
          }
        },
        "privateSources": {
          "type": "array",
          "items": { "$ref": "#/$defs/privateSource" }
        },
        "ownership": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/ownership" }
        },
        "privateIngestion": { "const": "disabled" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "native"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "native": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "observation": { "type": "string", "minLength": 1 }
      }
    },
    "record": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "from", "to"],
      "properties": {
        "relation": { "type": "string", "minLength": 1 },
        "from": { "$ref": "#/$defs/identity" },
        "to": { "$ref": "#/$defs/identity" }
      }
    },
    "observationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "observationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "transport", "endpoint", "dataset"],
      "properties": {
        "provider": { "enum": ["github", "cloudflare"] },
        "transport": { "enum": ["graphql", "rest"] },
        "endpoint": { "type": "string", "minLength": 1 },
        "dataset": { "type": "string", "minLength": 1 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "source", "resource", "metric", "dimensions", "unit", "window", "observedAt", "validUntil", "provenance", "availability", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "identity": { "$ref": "#/$defs/identity" },
        "source": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
        },
        "unit": { "type": "string", "minLength": 1 },
        "window": { "$ref": "#/$defs/observationWindow" },
        "observedAt": { "type": "string", "format": "date-time" },
        "validUntil": { "type": "string", "format": "date-time" },
        "provenance": { "$ref": "#/$defs/observationProvenance" },
        "availability": { "$ref": "#/$defs/availability" },
        "value": {}
      }
    },
    "collectionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "records", "relationships", "derived"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "records": {
          "type": "array",
          "items": { "$ref": "#/$defs/record" }
        },
        "relationships": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship" }
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limit", "returned", "total", "nextCursor"],
      "properties": {
        "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
        "returned": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "nextCursor": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "completeness": { "enum": ["complete", "partial"] },
        "partialReason": {
          "oneOf": [
            { "enum": ["page-boundary", "sample", "provider-export-bound", "provider-unavailable"] },
            { "type": "null" }
          ]
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filters"],
      "properties": {
        "filters": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "pagination": { "$ref": "#/$defs/pagination" }
      }
    },
    "queryDerived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "totalAvailable", "facets"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "totalAvailable": { "type": "integer", "minimum": 0 },
        "facets": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "queryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "contract", "dataset", "datasets", "availability", "sources", "qualifications", "query", "records", "derived"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "contract": { "const": "contracts/assurance/reporting.schema.json" },
        "dataset": { "type": "string", "minLength": 1 },
        "datasets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "availability": { "type": "object", "additionalProperties": { "$ref": "#/$defs/availability" } },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
        "qualifications": { "type": "object", "additionalProperties": { "type": ["string", "null"] } },
        "query": { "$ref": "#/$defs/query" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
        "derived": { "$ref": "#/$defs/queryDerived" }
      }
    },
    "registryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 1 }
      }
    },
    "resourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "schema", "collectionPath", "visibility"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^assurance/.+\\.json$" },
        "schema": { "type": "string", "pattern": "^contracts/assurance/.+\\.schema\\.json$" },
        "collectionPath": { "type": "string", "minLength": 1 },
        "visibility": { "$ref": "#/$defs/visibility" }
      }
    },
    "sourceRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "blob"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "blob": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "interchangeCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "resource", "revision", "records"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "resource": { "$ref": "#/$defs/resourceReference" },
        "revision": { "$ref": "#/$defs/sourceRevision" },
        "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
      }
    },
    "interchangeEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "registry", "collections"],
      "properties": {
        "contract": { "const": "contracts/assurance/reporting.schema.json" },
        "registry": { "$ref": "#/$defs/registryReference" },
        "collections": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/interchangeCollection" }
        }
      }
    }
  }
}
