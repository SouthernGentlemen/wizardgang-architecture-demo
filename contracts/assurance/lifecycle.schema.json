{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/lifecycle.schema.json",
  "title": "Public Assurance Record Lifecycle Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "records", "retiredRecords"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "lifecycle", "disclosureReview"],
      "properties": {
        "commit": { "const": "c2359f00fc3bac80bfbc2e82369a86f20e522f74" },
        "lifecycle": { "const": "Published" },
        "disclosureReview": { "$ref": "#/$defs/disclosureReview" }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycleRecord" }
    },
    "retiredRecords": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/lifecycleRecord" },
          {
            "properties": {
              "lifecycle": { "enum": ["Superseded", "Withdrawn"] }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "disclosureReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedAt", "reviewer", "basis"],
      "properties": {
        "status": { "const": "Reviewed" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "type": "string", "minLength": 3 },
        "basis": { "type": "string", "minLength": 10 }
      }
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "lifecycleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lifecycle", "disclosureReview"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "lifecycle": { "enum": ["Draft", "Approved", "Published", "Superseded", "Withdrawn"] },
        "disclosureReview": { "$ref": "#/$defs/disclosureReview" },
        "supersedes": { "$ref": "#/$defs/idList" },
        "supersededBy": { "$ref": "#/$defs/idList" },
        "withdrawalRationale": { "type": "string", "minLength": 10 }
      },
      "allOf": [
        {
          "if": { "properties": { "lifecycle": { "const": "Superseded" } }, "required": ["lifecycle"] },
          "then": { "required": ["supersededBy"] }
        },
        {
          "if": { "properties": { "lifecycle": { "const": "Withdrawn" } }, "required": ["lifecycle"] },
          "then": { "required": ["withdrawalRationale"] }
        }
      ]
    }
  }
}
