{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/lifecycle.schema.json",
  "title": "Public Assurance Record Lifecycle Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "reviewEvents", "sourceApprovals", "records", "retiredRecords"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historicalCommit", "migrationCommit", "membership", "lifecycle", "reviewRef"],
      "properties": {
        "historicalCommit": { "const": "c2359f00fc3bac80bfbc2e82369a86f20e522f74" },
        "migrationCommit": { "const": "6f8383cd6a318e0fe03506bc96401f5161c6e222" },
        "membership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "blob"],
          "properties": {
            "path": { "const": "src/assurance/generated/lifecycle-baseline-membership.json" },
            "blob": { "const": "e2f4aad3146649fdfe2063abc780dc73a99bdd64" }
          }
        },
        "lifecycle": { "const": "Published" },
        "reviewRef": { "$ref": "#/$defs/reference" }
      }
    },
    "reviewEvents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reviewEvent" }
    },
    "sourceApprovals": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceApproval" }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/lifecycleRecord" }
    },
    "retiredRecords": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/lifecycleRecord" },
          {
            "properties": {
              "lifecycle": { "enum": ["Superseded", "Withdrawn"] }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "reference": { "type": "string", "minLength": 3 },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reviewedAt", "reviewer", "basis"],
      "properties": {
        "id": { "$ref": "#/$defs/reference" },
        "status": { "enum": ["Reviewed", "Pending"] },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "type": "string", "minLength": 3 },
        "basis": { "type": "string", "minLength": 10 }
      }
    },
    "sourceApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resource", "revision", "reviewRef"],
      "properties": {
        "id": { "$ref": "#/$defs/reference" },
        "resource": { "$ref": "#/$defs/reference" },
        "revision": { "$ref": "#/$defs/gitObject" },
        "reviewRef": { "$ref": "#/$defs/reference" }
      }
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "lifecycleRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lifecycle", "reviewRef"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "lifecycle": { "enum": ["Draft", "Approved", "Published", "Superseded", "Withdrawn"] },
        "reviewRef": { "$ref": "#/$defs/reference" },
        "supersedes": { "$ref": "#/$defs/idList" },
        "supersededBy": { "$ref": "#/$defs/idList" },
        "withdrawalRationale": { "type": "string", "minLength": 10 }
      },
      "allOf": [
        {
          "if": { "properties": { "lifecycle": { "const": "Superseded" } }, "required": ["lifecycle"] },
          "then": { "required": ["supersededBy"] }
        },
        {
          "if": { "properties": { "lifecycle": { "const": "Withdrawn" } }, "required": ["lifecycle"] },
          "then": { "required": ["withdrawalRationale"] }
        }
      ]
    }
  }
}
