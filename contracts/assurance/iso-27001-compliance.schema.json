{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/iso-27001-compliance.schema.json",
  "title": "ISO/IEC 27001:2022 Public Compliance Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "visibility",
    "paraphraseNotice",
    "sourceSoa",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "iso-iec-27001-2022-public-compliance"
    },
    "visibility": {
      "const": "public"
    },
    "paraphraseNotice": {
      "type": "string",
      "minLength": 1
    },
    "sourceSoa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "governanceDocumentReference",
        "status",
        "approval"
      ],
      "properties": {
        "id": {
          "const": "WG-SOA-001"
        },
        "governanceDocumentReference": {
          "const": "WG-SOA-001"
        },
        "status": {
          "const": "approved"
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pullRequest",
            "mergeCommit"
          ],
          "properties": {
            "pullRequest": {
              "type": "integer",
              "minimum": 1
            },
            "mergeCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reference",
          "title",
          "kind",
          "section",
          "status",
          "applicability",
          "relationships"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ISO27001-[A0-9.]+$"
          },
          "reference": {
            "type": "string",
            "pattern": "^(?:[4-9]|10)\\.[0-9]+(?:\\.[0-9]+)?$|^A\\.[0-9]+(?:\\.[0-9]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "clause",
              "control"
            ]
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "met",
              "partial",
              "gap",
              "not-applicable"
            ]
          },
          "applicability": {
            "enum": [
              "applicable",
              "not-applicable"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 10
          },
          "relationships": {
            "$ref": "./relationships.schema.json"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not-applicable"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "rationale"
              ],
              "properties": {
                "applicability": {
                  "const": "not-applicable"
                }
              }
            }
          }
        ]
      }
    }
  }
}
