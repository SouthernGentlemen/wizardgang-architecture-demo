{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/objective.schema.json",
  "title": "Canonical Governance Objective Register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "governanceDocumentReference",
    "qualification",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "governanceDocumentReference": {
      "const": "WG-OBJ-001"
    },
    "qualification": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "initialState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "planned",
            "active",
            "met",
            "at-risk",
            "missed",
            "retired"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "area",
        "objective",
        "metric",
        "initialTarget",
        "owner",
        "evidenceSources",
        "reviewCadence",
        "initialState",
        "relationships"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-OBJ-[0-9]{3}$"
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "initialTarget": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "evidenceSources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reviewCadence": {
          "type": "string",
          "minLength": 1
        },
        "initialState": {
          "$ref": "#/$defs/initialState"
        },
        "relationships": {
          "$ref": "./relationships.schema.json"
        }
      }
    }
  }
}
