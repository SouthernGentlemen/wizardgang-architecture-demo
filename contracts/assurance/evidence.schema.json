{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/evidence.schema.json",
  "title": "Public Assurance Evidence Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title",
          "description",
          "locator",
          "freshnessPolicy",
          "visibility",
          "relationships"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^EVD-[A-Z]+-[0-9]{3,}$"
          },
          "kind": {
            "enum": [
              "source",
              "test",
              "workflow",
              "governance-record",
              "release",
              "live-route",
              "observation"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "repositoryPath": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "oneOf": [
              {
                "required": [
                  "repositoryPath"
                ]
              },
              {
                "required": [
                  "route"
                ]
              }
            ]
          },
          "freshnessPolicy": {
            "enum": [
              "release-bound",
              "event-driven",
              "observation-bound"
            ]
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "validUntil": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "const": "public"
          },
          "relationships": {
            "$ref": "./relationships.schema.json"
          }
        },
        "dependentRequired": {
          "observedAt": [
            "validUntil"
          ],
          "validUntil": [
            "observedAt"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "observation"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "observedAt",
                "validUntil"
              ]
            }
          }
        ]
      }
    }
  }
}
