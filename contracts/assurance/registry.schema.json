{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/registry.schema.json",
  "title": "Public Assurance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "scope", "qualification", "visibility", "lifecycle", "datasets", "presentations", "operations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "qualification": { "type": "string", "minLength": 1 },
    "visibility": { "const": "public" },
    "lifecycle": {
      "allOf": [
        { "$ref": "#/$defs/resource" },
        { "properties": { "kind": { "const": "lifecycle" }, "role": { "const": "control-plane" } } }
      ]
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset" }
    },
    "presentations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/resource" },
          { "properties": { "kind": { "const": "documents" }, "role": { "const": "presentation" } } }
        ]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/resource" },
          { "properties": { "kind": { "const": "operations" }, "role": { "const": "operations" } } }
        ]
      }
    }
  },
  "$defs": {
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "html": { "type": "string", "pattern": "^/" },
        "api": { "type": "string", "pattern": "^/" },
        "apiRecord": { "type": "string", "pattern": "^/.+\\{id\\}" }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "label"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/filter" }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role", "path", "schema", "visibility", "capabilities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "kind": { "enum": ["evidence", "claims", "compliance", "risks", "incidents", "exercises", "advisories", "lifecycle", "operations", "documents"] },
        "role": { "enum": ["dataset", "partition", "control-plane", "operations", "presentation"] },
        "path": { "type": "string", "pattern": "^assurance/.+\\.json$" },
        "schema": { "type": "string", "pattern": "^contracts/assurance/.+\\.schema\\.json$" },
        "visibility": { "enum": ["public", "private"] },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["runtime", "records", "api-index", "summary-source", "manifest", "lifecycle", "monitoring"] }
        },
        "qualification": { "type": "string", "minLength": 1 },
        "routes": { "$ref": "#/$defs/routes" },
        "filters": { "$ref": "#/$defs/filters" }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "role", "path", "schema", "visibility", "capabilities"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "kind": { "enum": ["evidence", "claims", "compliance", "risks", "incidents", "exercises", "advisories"] },
        "role": { "const": "dataset" },
        "path": { "type": "string", "pattern": "^assurance/.+\\.json$" },
        "schema": { "type": "string", "pattern": "^contracts/assurance/.+\\.schema\\.json$" },
        "visibility": { "enum": ["public", "private"] },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["runtime", "records", "api-index", "summary-source", "manifest", "lifecycle", "monitoring"] }
        },
        "qualification": { "type": "string", "minLength": 1 },
        "routes": { "$ref": "#/$defs/routes" },
        "filters": { "$ref": "#/$defs/filters" },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    }
  }
}
