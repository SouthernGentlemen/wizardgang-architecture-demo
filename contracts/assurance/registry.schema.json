{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/registry.schema.json",
  "title": "Public Assurance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "scope",
    "qualification",
    "visibility",
    "routes",
    "reporting",
    "lifecycle",
    "datasets",
    "presentations",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "qualification": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "const": "public"
    },
    "routes": {
      "$ref": "#/$defs/routes"
    },
    "reporting": {
      "$ref": "./reporting.schema.json#/$defs/registryReporting"
    },
    "lifecycle": {
      "allOf": [
        {
          "$ref": "#/$defs/resource"
        },
        {
          "properties": {
            "kind": {
              "const": "lifecycle"
            },
            "role": {
              "const": "control-plane"
            }
          }
        }
      ]
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dataset"
      }
    },
    "presentations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/resource"
          },
          {
            "properties": {
              "kind": {
                "const": "documents"
              },
              "role": {
                "const": "presentation"
              }
            }
          }
        ]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/resource"
          },
          {
            "properties": {
              "kind": {
                "const": "operations"
              },
              "role": {
                "const": "operations"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "routeAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "fragment": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "html": {
          "type": "string",
          "pattern": "^/"
        },
        "api": {
          "type": "string",
          "pattern": "^/"
        },
        "apiRecord": {
          "type": "string",
          "pattern": "^/.+\\{id\\}"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/routeAlias"
          }
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "label"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/filter"
      }
    },
    "recordCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "identity"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
        },
        "identity": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
              },
              {
                "$ref": "#/$defs/identityComponent"
              }
            ]
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "path",
        "schema",
        "visibility",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "role": {
          "enum": [
            "dataset",
            "partition",
            "control-plane",
            "operations",
            "presentation"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^assurance/.+\\.json$"
        },
        "schema": {
          "type": "string",
          "pattern": "^contracts/assurance/.+\\.schema\\.json$"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "runtime",
              "records",
              "api-index",
              "summary-source",
              "manifest",
              "lifecycle",
              "monitoring"
            ]
          }
        },
        "recordCollection": {
          "$ref": "#/$defs/recordCollection"
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "routeOwner": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "framework": {
          "$ref": "#/$defs/framework"
        },
        "partition": {
          "$ref": "#/$defs/partition"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceLeaf"
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "path",
        "schema",
        "visibility",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "role": {
          "const": "dataset"
        },
        "path": {
          "type": "string",
          "pattern": "^assurance/.+\\.json$"
        },
        "schema": {
          "type": "string",
          "pattern": "^contracts/assurance/.+\\.schema\\.json$"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "runtime",
              "records",
              "api-index",
              "summary-source",
              "manifest",
              "lifecycle",
              "monitoring"
            ]
          }
        },
        "recordCollection": {
          "$ref": "#/$defs/recordCollection"
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "routeOwner": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "framework": {
          "$ref": "#/$defs/framework"
        },
        "partition": {
          "$ref": "#/$defs/partition"
        }
      }
    },
    "identityComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "path"
      ],
      "properties": {
        "source": {
          "enum": [
            "record",
            "resource"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "edition",
        "qualification",
        "assessmentDate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "assessmentDate": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "label"
      ],
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resourceLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "path",
        "schema",
        "visibility",
        "capabilities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "role": {
          "enum": [
            "dataset",
            "partition",
            "control-plane",
            "operations",
            "presentation"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^assurance/.+\\.json$"
        },
        "schema": {
          "type": "string",
          "pattern": "^contracts/assurance/.+\\.schema\\.json$"
        },
        "visibility": {
          "enum": [
            "public",
            "private"
          ]
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "runtime",
              "records",
              "api-index",
              "summary-source",
              "manifest",
              "lifecycle",
              "monitoring"
            ]
          }
        },
        "recordCollection": {
          "$ref": "#/$defs/recordCollection"
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "routes": {
          "$ref": "#/$defs/routes"
        },
        "routeOwner": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "framework": {
          "$ref": "#/$defs/framework"
        },
        "partition": {
          "$ref": "#/$defs/partition"
        }
      }
    }
  }
}
