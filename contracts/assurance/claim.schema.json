{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/claim.schema.json",
  "title": "Public Assurance Claim Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "title", "statement", "posture", "frameworkReferences", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^CLM-[A-Z]+-[0-9]{3,}$" },
          "area": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "posture": { "enum": ["met", "partial", "gap", "not-applicable"] },
          "frameworkReferences": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^EVD-[A-Z]+-[0-9]{3,}$" }, "uniqueItems": true }
        }
      }
    }
  }
}
