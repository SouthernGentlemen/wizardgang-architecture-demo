{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/advisory.schema.json",
  "title": "Published Security Advisory Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "qualification", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "qualification": { "type": "string", "minLength": 1 },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recordType", "title", "severity", "summary", "publishedAt", "fixedReleases", "incidentLinks", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^GHSA-[a-z0-9]{4}-[a-z0-9]{4}-[a-z0-9]{4}$" },
        "recordType": { "const": "advisory" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "severity": { "enum": ["low", "moderate", "high", "critical"] },
        "summary": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "fixedReleases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
        },
        "cveId": { "type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$" },
        "incidentLinks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^INC-[0-9]{3,}$" }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^EVD-[A-Z]+-[0-9]{3,}$" }
        }
      }
    }
  }
}
