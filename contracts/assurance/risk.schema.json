{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/risk.schema.json",
  "title": "Disclosure-safe Public Assurance Risks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceRegisters",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceRegisters": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "governanceDocumentReference"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WG-REG-[0-9]{3}$"
          },
          "governanceDocumentReference": {
            "type": "string",
            "pattern": "^WG-REG-[0-9]{3}$"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/risk"
      }
    }
  },
  "$defs": {
    "rating": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical"
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "rating"
      ],
      "properties": {
        "score": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "rating": {
          "$ref": "#/$defs/rating"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "framework",
        "title",
        "inherent",
        "residual",
        "treatment",
        "status",
        "reviewDue",
        "relationships",
        "relationships"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(SEC|AI)-RISK-[0-9]{3}$"
        },
        "framework": {
          "enum": [
            "security",
            "ai"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "inherent": {
          "$ref": "#/$defs/score"
        },
        "residual": {
          "$ref": "#/$defs/score"
        },
        "treatment": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "avoid",
              "reduce",
              "share"
            ]
          }
        },
        "status": {
          "enum": [
            "open",
            "treating"
          ]
        },
        "reviewDue": {
          "type": "string",
          "format": "date"
        },
        "relationships": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence",
            "compliance",
            "frameworks",
            "claims",
            "risks",
            "controls",
            "incidents",
            "exercises",
            "advisories",
            "governanceDocuments",
            "objectives"
          ],
          "properties": {
            "evidence": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^EVD-[A-Z]+-[0-9]{3,}$"
              }
            },
            "compliance": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(ISO27001|ISO42001)-[A0-9.]+$|^WCAG-[0-9.]+$"
              }
            },
            "frameworks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(iso-27001|iso-42001|wcag-2\\.2)$"
              }
            },
            "claims": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^CLM-[A-Z]+-[0-9]{3,}$"
              }
            },
            "risks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(SEC|AI)-RISK-[0-9]{3}$"
              }
            },
            "controls": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(ISO27001|ISO42001)-A\\.[0-9.]+$"
              }
            },
            "incidents": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^INC-[0-9]{3,}$"
              }
            },
            "exercises": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^EX-[0-9]{3,}$"
              }
            },
            "advisories": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^ADV-[0-9]{3,}$"
              }
            },
            "governanceDocuments": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^WG-[A-Z]+-[0-9]{3}$"
              }
            },
            "objectives": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z]+-OBJ-[0-9]{3}$"
              }
            }
          }
        }
      }
    }
  }
}
