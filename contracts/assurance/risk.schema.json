{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/risk.schema.json",
  "title": "Disclosure-safe Public Assurance Risks",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRegisters", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceRegisters": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repositoryPath"],
        "properties": {
          "id": { "type": "string", "pattern": "^WG-REG-[0-9]{3}$" },
          "repositoryPath": { "type": "string", "pattern": "^docs/governance/registers/[A-Z-]+\\.md$" }
        }
      }
    },
    "records": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/risk" } }
  },
  "$defs": {
    "rating": { "enum": ["low", "moderate", "high", "critical"] },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "rating"],
      "properties": {
        "score": { "type": "integer", "minimum": 1, "maximum": 25 },
        "rating": { "$ref": "#/$defs/rating" }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "repositoryPath"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "repositoryPath": { "type": "string", "pattern": "^(docs/|SECURITY\\.md$)" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "framework", "title", "inherent", "residual", "treatment", "status", "controls", "evidence", "reviewDue"],
      "properties": {
        "id": { "type": "string", "pattern": "^(SEC|AI)-RISK-[0-9]{3}$" },
        "framework": { "enum": ["security", "ai"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "inherent": { "$ref": "#/$defs/score" },
        "residual": { "$ref": "#/$defs/score" },
        "treatment": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["avoid", "reduce", "share"] } },
        "status": { "enum": ["open", "treating"] },
        "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/control" } },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^EVD-[A-Z]+-[0-9]{3,}$" } },
        "reviewDue": { "type": "string", "format": "date" }
      }
    }
  }
}
