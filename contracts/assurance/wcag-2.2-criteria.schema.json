{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/wcag-2.2-criteria.schema.json",
  "title": "WCAG 2.2 Public Criterion Partition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "principle",
    "framework",
    "frameworkLabel",
    "sourcePath",
    "criteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "name"
      ],
      "properties": {
        "number": {
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ]
        },
        "name": {
          "enum": [
            "Perceivable",
            "Operable",
            "Understandable",
            "Robust"
          ]
        }
      }
    },
    "framework": {
      "const": "wcag-2.2"
    },
    "frameworkLabel": {
      "const": "WCAG 2.2"
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^assurance/compliance/wcag-2\\.2/[a-z-]+\\.json$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "framework",
          "frameworkLabel",
          "reference",
          "title",
          "kind",
          "section",
          "status",
          "level",
          "applicability",
          "implementation",
          "validation",
          "gaps",
          "owner",
          "freshnessRules",
          "relationships",
          "sourcePath"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WCAG-[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "framework": {
            "const": "wcag-2.2"
          },
          "frameworkLabel": {
            "const": "WCAG 2.2"
          },
          "reference": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "criterion"
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "demonstrated",
              "partial",
              "gap",
              "not-observed"
            ]
          },
          "level": {
            "enum": [
              "A",
              "AA",
              "AAA"
            ]
          },
          "applicability": {
            "const": "applicable"
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "automated",
              "manual"
            ],
            "properties": {
              "automated": {
                "enum": [
                  "partial",
                  "none"
                ]
              },
              "manual": {
                "const": "required"
              }
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "freshnessRules": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "release-bound",
                "content-change",
                "interaction-change",
                "quarterly-manual"
              ]
            }
          },
          "relationships": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence",
              "compliance",
              "frameworks",
              "claims",
              "risks",
              "controls",
              "incidents",
              "exercises",
              "advisories",
              "governanceDocuments",
              "objectives"
            ],
            "properties": {
              "evidence": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^EVD-[A-Z]+-[0-9]{3,}$"
                }
              },
              "compliance": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(ISO27001|ISO42001)-[A0-9.]+$|^WCAG-[0-9.]+$"
                }
              },
              "frameworks": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(iso-27001|iso-42001|wcag-2\\.2)$"
                }
              },
              "claims": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^CLM-[A-Z]+-[0-9]{3,}$"
                }
              },
              "risks": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(SEC|AI)-RISK-[0-9]{3}$"
                }
              },
              "controls": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(ISO27001|ISO42001)-A\\.[0-9.]+$"
                }
              },
              "incidents": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^INC-[0-9]{3,}$"
                }
              },
              "exercises": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^EX-[0-9]{3,}$"
                }
              },
              "advisories": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^ADV-[0-9]{3,}$"
                }
              },
              "governanceDocuments": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^WG-[A-Z]+-[0-9]{3}$"
                }
              },
              "objectives": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]+-OBJ-[0-9]{3}$"
                }
              }
            }
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^assurance/compliance/wcag-2\\.2/[a-z-]+\\.json$"
          }
        }
      }
    }
  }
}
