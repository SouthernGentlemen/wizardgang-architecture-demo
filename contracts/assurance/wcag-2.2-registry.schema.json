{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/wcag-2.2-registry.schema.json",
  "title": "WCAG 2.2 Public Registry Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "visibility",
    "scope",
    "statusDefinitions",
    "validationDefinitions",
    "sources",
    "freshnessRules",
    "registryRelationships"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "const": "wcag-2-2-public-registry"
    },
    "visibility": {
      "const": "public"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "statusDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "demonstrated",
        "partial",
        "gap",
        "not-observed"
      ],
      "properties": {
        "demonstrated": {
          "type": "string",
          "minLength": 1
        },
        "partial": {
          "type": "string",
          "minLength": 1
        },
        "gap": {
          "type": "string",
          "minLength": 1
        },
        "not-observed": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validationDefinitions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automated",
        "manual"
      ],
      "properties": {
        "automated": {
          "type": "string",
          "minLength": 1
        },
        "manual": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normative",
        "machineReadable",
        "conformanceUnderstanding",
        "techniquesUnderstanding",
        "retrievedDate",
        "attribution"
      ],
      "properties": {
        "normative": {
          "const": "https://www.w3.org/TR/WCAG22/"
        },
        "machineReadable": {
          "const": "https://www.w3.org/WAI/WCAG22/wcag.json"
        },
        "conformanceUnderstanding": {
          "const": "https://www.w3.org/WAI/WCAG22/Understanding/conformance.html"
        },
        "techniquesUnderstanding": {
          "const": "https://www.w3.org/WAI/WCAG22/Understanding/understanding-techniques.html"
        },
        "retrievedDate": {
          "type": "string",
          "format": "date"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "freshnessRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release-bound",
        "content-change",
        "interaction-change",
        "quarterly-manual"
      ],
      "properties": {
        "release-bound": {
          "type": "string",
          "minLength": 1
        },
        "content-change": {
          "type": "string",
          "minLength": 1
        },
        "interaction-change": {
          "type": "string",
          "minLength": 1
        },
        "quarterly-manual": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "registryRelationships": {
      "$ref": "./relationships.schema.json"
    }
  }
}
