{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/operations.schema.json",
  "title": "Assurance Operational Monitoring Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseUrl", "accountableOwners", "securityReporting"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "accountableOwners": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 3 }
    },
    "securityReporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyRoute", "securityTxtRoute", "privateReportingUrl", "privateReportingApi", "expirySource"],
      "properties": {
        "policyRoute": { "type": "string", "pattern": "^/" },
        "securityTxtRoute": { "type": "string", "pattern": "^/" },
        "privateReportingUrl": { "type": "string", "format": "uri" },
        "privateReportingApi": { "type": "string", "format": "uri" },
        "expirySource": { "type": "string", "minLength": 1 }
      }
    }
  }
}
