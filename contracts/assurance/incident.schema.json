{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/incident.schema.json",
  "title": "Public Incident Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRegister", "qualification", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceRegister": { "const": "docs/governance/registers/INCIDENT-REGISTER.md" },
    "qualification": { "type": "string", "minLength": 1 },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "recordType", "simulated", "title", "status", "categories", "summary", "relationships"],
      "properties": {
        "id": { "type": "string", "pattern": "^INC-[0-9]{3,}$" },
        "recordType": { "const": "incident" },
        "simulated": { "const": false },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["investigating", "contained", "recovering", "monitoring", "closed", "superseded"] },
        "detectedAt": { "type": "string", "format": "date-time" },
        "initialSeverity": { "enum": ["SEV-1", "SEV-2", "SEV-3", "SEV-4"] },
        "finalSeverity": { "enum": ["SEV-1", "SEV-2", "SEV-3", "SEV-4"] },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "security",
              "ai-mcp",
              "supplier",
              "data",
              "operational",
              "privacy-confidentiality",
              "accessibility",
              "governance-evidence"
            ]
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "closedAt": { "type": "string", "format": "date-time" },
        "relationships": { "$ref": "./relationships.schema.json" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "closed" } },
            "required": ["status"]
          },
          "then": { "required": ["closedAt"] }
        }
      ]
    }
  }
}
