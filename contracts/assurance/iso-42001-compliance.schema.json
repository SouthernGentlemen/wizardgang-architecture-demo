{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/iso-42001-compliance.schema.json",
  "title": "ISO/IEC 42001:2023 Public Compliance Dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "standard",
    "edition",
    "visibility",
    "qualification",
    "paraphraseNotice",
    "sourceSoa",
    "scopeLimitations",
    "framework",
    "records"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "iso-iec-42001-2023-public-compliance" },
    "standard": { "const": "ISO/IEC 42001:2023" },
    "edition": { "const": "2023" },
    "visibility": { "const": "public" },
    "qualification": { "type": "string", "minLength": 1 },
    "paraphraseNotice": { "type": "string", "minLength": 1 },
    "sourceSoa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "governanceDocumentReference", "status", "assessmentDate", "approval"],
      "properties": {
        "id": { "const": "WG-SOA-002" },
        "governanceDocumentReference": { "const": "WG-SOA-002" },
        "status": { "const": "approved" },
        "assessmentDate": { "type": "string", "format": "date" },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pullRequest", "mergeCommit"],
          "properties": {
            "pullRequest": { "type": "integer", "minimum": 1 },
            "mergeCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      }
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "edition", "qualification", "assessmentDate", "sourcePath"],
      "properties": {
        "id": { "const": "iso-42001" },
        "label": { "const": "ISO/IEC 42001:2023" },
        "edition": { "const": "2023" },
        "qualification": { "type": "string", "minLength": 1 },
        "assessmentDate": { "type": "string", "format": "date" },
        "sourcePath": { "const": "assurance/compliance/iso-42001-2023.json" }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "framework",
          "frameworkLabel",
          "reference",
          "title",
          "kind",
          "section",
          "status",
          "applicability",
          "relationships",
          "sourcePath"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^ISO42001-[A0-9.]+$" },
          "framework": { "const": "iso-42001" },
          "frameworkLabel": { "const": "ISO/IEC 42001:2023" },
          "reference": {
            "type": "string",
            "pattern": "^(?:[4-9]|10)\\.[0-9]+(?:\\.[0-9]+)?$|^A\\.[0-9]+(?:\\.[0-9]+)+$"
          },
          "title": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": { "enum": ["clause", "control"] },
          "section": { "type": "string", "minLength": 1 },
          "status": { "enum": ["met", "partial", "gap", "not-applicable"] },
          "applicability": { "enum": ["applicable", "not-applicable"] },
          "rationale": { "type": "string", "minLength": 10 },
          "relationships": { "$ref": "./relationships.schema.json" },
          "sourcePath": { "const": "assurance/compliance/iso-42001-2023.json" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "not-applicable" } },
              "required": ["status"]
            },
            "then": {
              "required": ["rationale"],
              "properties": { "applicability": { "const": "not-applicable" } }
            }
          }
        ]
      }
    },
    "scopeLimitations": { "type": "object" }
  }
}
