{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/relationships.schema.json",
  "title": "Canonical record-local reporting relationships",
  "description": "Identity-based reporting edges. Record-local canonical identities are logical source/native identities; revisions are supplied by reporting envelopes rather than duplicated into the edge.",
  "type": "array",
  "uniqueItems": true,
  "items": {
    "$ref": "#/$defs/relationship"
  },
  "$defs": {
    "relation": {
      "enum": [
        "evidence",
        "compliance",
        "frameworks",
        "claims",
        "risks",
        "controls",
        "incidents",
        "exercises",
        "advisories",
        "governanceDocuments",
        "objectives"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "native"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "native": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "from",
        "to"
      ],
      "properties": {
        "relation": {
          "$ref": "#/$defs/relation"
        },
        "from": {
          "$ref": "#/$defs/identity"
        },
        "to": {
          "$ref": "#/$defs/identity"
        }
      }
    }
  }
}
