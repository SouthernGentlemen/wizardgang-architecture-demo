{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo.wizardgang.ai/contracts/assurance/presentation-document.schema.json",
  "title": "Assurance Presentation Document Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documents": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1
        },
        "mergeCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "dependentRequired": {
        "pullRequest": [
          "mergeCommit"
        ],
        "mergeCommit": [
          "pullRequest"
        ]
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dueDate": {
          "type": "string",
          "format": "date"
        },
        "cadence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "governanceDocumentReference",
        "title",
        "type",
        "owner",
        "review",
        "approval",
        "sourceDatasets"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^WG-(REG|SOA)-[0-9]{3}$"
        },
        "governanceDocumentReference": {
          "type": "string",
          "pattern": "^WG-(REG|SOA)-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "risk-register",
            "incident-exercise-register",
            "soa"
          ]
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "methodReference": {
          "type": "string",
          "pattern": "^WG-GOV-[0-9]{3}$"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "published",
            "superseded",
            "withdrawn"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "assessmentDate": {
          "type": "string",
          "format": "date"
        },
        "baselineDate": {
          "type": "string",
          "format": "date"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "approval": {
          "$ref": "#/$defs/approval"
        },
        "sourceDatasets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          }
        },
        "recordSelector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "framework"
          ],
          "properties": {
            "framework": {
              "enum": [
                "security",
                "ai"
              ]
            }
          }
        }
      }
    }
  }
}
