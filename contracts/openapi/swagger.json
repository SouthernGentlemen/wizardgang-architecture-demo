{
  "swagger": "2.0",
  "info": {
    "title": "WizardGang Architecture Demo REST API",
    "version": "1.2.0",
    "description": "Executable OpenAPI 2.0 contract for the versioned D1-backed REST resource. Reads are public. Writes accept either a short-lived identity-derived visitor token scoped to one sandbox or the managed operator credential, which is never exposed by the public explorer."
  },
  "host": "demo.wizardgang.ai",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "BearerToken": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "A ten-minute demo token issued after provider sign-in. Its demo:write permission is restricted to the caller's server-derived visitor sandbox. A managed operator credential is also accepted but never exposed by the public explorer."
    }
  },
  "paths": {
    "/demo-records": {
      "get": {
        "summary": "List records",
        "description": "List at most 100 records. Anonymous requests read the public namespace; an identity-derived token reads its visitor sandbox.",
        "parameters": [
          { "name": "namespace", "in": "query", "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "description": "Anonymous reads are fixed to public. Operators may select a namespace; this value is ignored for identity-derived visitor tokens." }
        ],
        "responses": {
          "200": {
            "description": "Record collection",
            "schema": {
              "type": "object",
              "required": ["results", "authorization"],
              "properties": {
                "results": { "type": "array", "items": { "$ref": "#/definitions/DemoRecord" } },
                "authorization": { "type": "object" }
              }
            }
          },
          "503": { "description": "Demo intentionally offline or dependency unavailable" }
        }
      },
      "post": {
        "summary": "Create a record",
        "description": "Create a new key. Returns 409 when that key already exists; use PUT to replace it.",
        "security": [{ "BearerToken": [] }],
        "parameters": [
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/RecordInput" } }
        ],
        "responses": {
          "201": { "description": "Record created", "schema": { "$ref": "#/definitions/DemoRecord" } },
          "400": { "description": "Invalid record" },
          "401": { "description": "Authentication required" },
          "409": { "description": "Key already exists" },
          "503": { "description": "Demo intentionally offline or dependency unavailable" }
        }
      }
    },
    "/demo-records/{key}": {
      "get": {
        "summary": "Read one record",
        "parameters": [
          { "name": "key", "in": "path", "required": true, "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "x-example": "visitor-note" },
          { "name": "namespace", "in": "query", "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "description": "Anonymous reads are fixed to public. Operators may select a namespace; this value is ignored for identity-derived visitor tokens." }
        ],
        "responses": {
          "200": { "description": "Record", "schema": { "$ref": "#/definitions/DemoRecord" } },
          "404": { "description": "Record not found" },
          "503": { "description": "Unavailable" }
        }
      },
      "put": {
        "summary": "Create or replace one record",
        "description": "Create the requested key or replace its complete value.",
        "security": [{ "BearerToken": [] }],
        "parameters": [
          { "name": "key", "in": "path", "required": true, "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "x-example": "visitor-note" },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["value"],
              "example": { "value": { "note": "replaced" } },
              "properties": {
                "namespace": { "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "description": "Optional managed-operator namespace. Ignored for identity-derived visitor tokens." },
                "value": {}
              },
              "additionalProperties": false
            }
          }
        ],
        "responses": {
          "200": { "description": "Existing record replaced", "schema": { "$ref": "#/definitions/DemoRecord" } },
          "201": { "description": "Record created at the requested key", "schema": { "$ref": "#/definitions/DemoRecord" } },
          "400": { "description": "Invalid record" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Unavailable" }
        }
      },
      "delete": {
        "summary": "Delete one record",
        "security": [{ "BearerToken": [] }],
        "parameters": [
          { "name": "key", "in": "path", "required": true, "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "x-example": "visitor-note" },
          { "name": "namespace", "in": "query", "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "description": "Ignored for identity-derived visitor tokens." }
        ],
        "responses": {
          "204": { "description": "Record absent after deletion" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Unavailable" }
        }
      }
    }
  },
  "definitions": {
    "DemoRecord": {
      "type": "object",
      "required": ["namespace", "key", "value", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "integer" },
        "namespace": { "type": "string" },
        "key": { "type": "string" },
        "value": {},
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "RecordInput": {
      "type": "object",
      "required": ["key", "value"],
      "example": { "key": "visitor-note", "value": { "note": "hello" } },
      "properties": {
        "namespace": { "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "description": "Optional managed-operator namespace. Ignored for identity-derived visitor tokens." },
        "key": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
        "value": {}
      },
      "additionalProperties": false
    }
  }
}
