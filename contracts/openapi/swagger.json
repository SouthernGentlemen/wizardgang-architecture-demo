{
  "swagger": "2.0",
  "info": {
    "title": "WizardGang Architecture Demo REST API",
    "version": "1.1.0",
    "description": "Executable Swagger 2.0 contract for the versioned REST and signed-webhook demonstration. Reads are public; mutations use the same bearer authorization boundary as GraphQL and MCP."
  },
  "host": "demo.wizardgang.ai",
  "basePath": "/v1",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "BearerToken": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "x-value-prefix": "Bearer ",
      "description": "Use Authorization: Bearer <DEMO_API_TOKEN>. The token is supplied through managed secrets and never committed."
    }
  },
  "paths": {
    "/demo-records": {
      "get": {
        "summary": "List demo records",
        "parameters": [{ "name": "namespace", "in": "query", "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" }],
        "responses": {
          "200": { "description": "Demo record collection", "schema": { "$ref": "#/definitions/RecordCollection" } },
          "503": { "description": "Demo intentionally offline or dependency unavailable" }
        }
      },
      "post": {
        "summary": "Create or update a bounded demo record",
        "security": [{ "BearerToken": [] }],
        "parameters": [{ "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/RecordInput" } }],
        "responses": {
          "201": { "description": "Record stored" },
          "400": { "description": "Invalid record" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Demo intentionally offline or dependency unavailable" }
        }
      }
    },
    "/demo-records/{key}": {
      "get": {
        "summary": "Read one demo record",
        "parameters": [{ "name": "key", "in": "path", "required": true, "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "x-example": "visitor-note" }, { "name": "namespace", "in": "query", "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" }],
        "responses": { "200": { "description": "Record", "schema": { "$ref": "#/definitions/DemoRecord" } }, "404": { "description": "Not found" }, "503": { "description": "Unavailable" } }
      },
      "delete": {
        "summary": "Delete one demo record",
        "security": [{ "BearerToken": [] }],
        "parameters": [{ "name": "key", "in": "path", "required": true, "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$", "x-example": "visitor-note" }, { "name": "namespace", "in": "query", "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" }],
        "responses": { "204": { "description": "Deleted" }, "401": { "description": "Authentication required" }, "503": { "description": "Unavailable" } }
      }
    },
    "/webhooks/demo": {
      "post": {
        "summary": "Receive a signed, replay-protected demo webhook",
        "parameters": [
          { "name": "X-Demo-Delivery-Id", "in": "header", "required": true, "type": "string", "maxLength": 100, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,99}$", "x-example": "visitor-example", "description": "Unique delivery identifier used for replay protection." },
          { "name": "X-Demo-Signature", "in": "header", "required": true, "type": "string", "description": "Lowercase HMAC-SHA256 hex digest of the exact request body." },
          { "name": "body", "in": "body", "required": true, "schema": { "$ref": "#/definitions/WebhookEvent" } }
        ],
        "responses": { "202": { "description": "Signature verified and receipt stored" }, "401": { "description": "Invalid signature" }, "409": { "description": "Duplicate delivery" }, "503": { "description": "Unavailable" } }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Fetch this Swagger 2.0 contract",
        "responses": { "200": { "description": "Swagger document" } }
      }
    }
  },
  "definitions": {
    "RecordInput": {
      "type": "object",
      "required": ["key", "value"],
      "example": { "namespace": "public", "key": "visitor-note", "value": { "note": "hello" } },
      "properties": {
        "namespace": { "type": "string", "default": "public", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
        "key": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$" },
        "value": {}
      },
      "additionalProperties": false
    },
    "DemoRecord": {
      "type": "object",
      "required": ["id", "namespace", "key", "value", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "integer" },
        "namespace": { "type": "string" },
        "key": { "type": "string" },
        "value": {},
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "RecordCollection": {
      "type": "object",
      "properties": {
        "results": { "type": "array", "items": { "$ref": "#/definitions/DemoRecord" } },
        "authorization": { "type": "object" }
      }
    },
    "WebhookEvent": {
      "type": "object",
      "required": ["type", "data", "sentAt"],
      "example": { "type": "demo.record.changed", "data": { "key": "visitor-example" }, "sentAt": "2026-08-31T12:00:00.000Z" },
      "properties": {
        "type": { "type": "string", "pattern": "^demo\\.[a-z.]{1,60}$" },
        "data": { "type": "object" },
        "sentAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
