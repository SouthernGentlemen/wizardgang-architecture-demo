{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "WizardGang Architecture Demo REST API",
    "version": "1.4.0",
    "description": "Executable OpenAPI 3.1 contract for the current canonical REST, laboratory, and reporting interfaces. Reporting response schemas are mechanically synchronized from the canonical assurance contracts."
  },
  "servers": [
    {
      "url": "https://demo.wizardgang.ai",
      "description": "Public architecture demo"
    }
  ],
  "tags": [
    {
      "name": "Records",
      "description": "D1-backed demonstration records with public reads and visitor-scoped authenticated writes."
    },
    {
      "name": "Assurance",
      "description": "Public current-state assurance reporting backed by the canonical reporting contract."
    }
  ],
  "paths": {
    "/api/labs/rest-records": {
      "get": {
        "tags": [
          "Records"
        ],
        "summary": "List records",
        "description": "List at most 100 records. Anonymous requests read the public namespace; an identity-derived token reads its visitor sandbox.",
        "operationId": "listDemoRecords",
        "x-route-id": "platform.d1.records",
        "x-request-limits": {
          "maxIdentifierCharacters": 64,
          "maxResults": 100
        },
        "parameters": [
          {
            "name": "namespace",
            "in": "query",
            "required": false,
            "description": "Anonymous reads are fixed to public. Operators may select a namespace; this value is ignored for identity-derived visitor tokens.",
            "schema": {
              "type": "string",
              "default": "public",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
            },
            "example": "public"
          }
        ],
        "responses": {
          "200": {
            "description": "Record collection",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "results",
                    "authorization"
                  ],
                  "properties": {
                    "results": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "$ref": "#/components/schemas/DemoRecord"
                      }
                    },
                    "authorization": {
                      "$ref": "#/components/schemas/AuthorizationSummary"
                    }
                  }
                },
                "example": {
                  "results": [
                    {
                      "id": 1,
                      "namespace": "public",
                      "key": "architecture",
                      "value": {
                        "edge": true
                      },
                      "createdAt": "2026-09-02T12:00:00.000Z",
                      "updatedAt": "2026-09-02T12:00:00.000Z"
                    }
                  ],
                  "authorization": {
                    "subject": "public-visitor",
                    "authentication": "anonymous",
                    "permissions": [
                      "demo:read"
                    ],
                    "scope": "public"
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "post": {
        "tags": [
          "Records"
        ],
        "summary": "Create a record",
        "description": "Create a new key in the authorized namespace. Returns 409 when that key already exists; use PUT to replace it.",
        "operationId": "createDemoRecord",
        "x-route-id": "platform.d1.records",
        "x-authorization": "demo:write",
        "x-request-limits": {
          "maxBodyBytes": 16384,
          "maxValueBytes": 4096,
          "maxIdentifierCharacters": 64
        },
        "security": [
          {
            "BearerToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordInput"
              },
              "example": {
                "key": "visitor-note",
                "value": {
                  "message": "hello"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Record created",
            "headers": {
              "Location": {
                "description": "Canonical record URL within the authorized namespace.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoRecord"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/api/labs/rest-records/{id}": {
      "get": {
        "tags": [
          "Records"
        ],
        "summary": "Read one record",
        "operationId": "getDemoRecord",
        "x-route-id": "platform.d1.record",
        "x-request-limits": {
          "maxIdentifierCharacters": 64
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
            },
            "example": "visitor-note"
          },
          {
            "name": "namespace",
            "in": "query",
            "required": false,
            "description": "Anonymous reads are fixed to public. Operators may select a namespace; this value is ignored for identity-derived visitor tokens.",
            "schema": {
              "type": "string",
              "default": "public",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
            },
            "example": "public"
          }
        ],
        "responses": {
          "200": {
            "description": "Record",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoRecord"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "put": {
        "tags": [
          "Records"
        ],
        "summary": "Create or replace one record",
        "description": "Create the requested key or replace its complete value in the authorized namespace.",
        "operationId": "putDemoRecord",
        "x-route-id": "platform.d1.record",
        "x-authorization": "demo:write",
        "x-request-limits": {
          "maxBodyBytes": 16384,
          "maxValueBytes": 4096,
          "maxIdentifierCharacters": 64
        },
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
            },
            "example": "visitor-note"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordReplacement"
              },
              "example": {
                "value": {
                  "message": "updated"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing record replaced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoRecord"
                }
              }
            }
          },
          "201": {
            "description": "Record created at the requested key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoRecord"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      },
      "delete": {
        "tags": [
          "Records"
        ],
        "summary": "Delete one record",
        "operationId": "deleteDemoRecord",
        "x-route-id": "platform.d1.record",
        "x-authorization": "demo:write",
        "x-request-limits": {
          "maxIdentifierCharacters": 64
        },
        "security": [
          {
            "BearerToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
            },
            "example": "visitor-note"
          },
          {
            "name": "namespace",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "public",
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
            },
            "example": "public"
          }
        ],
        "responses": {
          "204": {
            "description": "Record absent after deletion"
          },
          "400": {
            "$ref": "#/components/responses/InvalidRequest"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/PermissionDenied"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
