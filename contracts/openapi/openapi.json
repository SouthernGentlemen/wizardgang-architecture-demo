  "components": {
    "securitySchemes": {
      "BearerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "A ten-minute demo token issued after provider sign-in. Its demo:write permission is restricted to the caller's server-derived visitor sandbox. A managed operator credential is also accepted but never exposed by the public explorer."
      }
    },
    "headers": {
      "RequestId": {
        "description": "Public-safe request correlation identifier.",
        "schema": {
          "type": "string",
          "pattern": "^req_[a-f0-9]+$"
        }
      }
    },
    "parameters": {
      "AssuranceLimit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Optional page size from 1 to 100. When cursor is provided without limit, the default is 50.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "example": 50
      },
      "AssuranceCursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "description": "Stable canonical record ID from the previous page.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "responses": {
      "InvalidRequest": {
        "description": "Invalid record, identifier, or JSON request.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "A valid bearer credential is required.",
        "headers": {
          "WWW-Authenticate": {
            "schema": {
              "type": "string"
            },
            "example": "Bearer realm=\"WizardGang architecture demo\""
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "authentication_required"
            }
          }
        }
      },
      "PermissionDenied": {
        "description": "The authenticated principal lacks the required permission.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "permission_denied"
            }
          }
        }
      },
      "Conflict": {
        "description": "The requested key already exists.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "record_already_exists",
              "message": "POST creates a new resource. Use PUT to replace an existing key."
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The JSON request exceeds 16 KiB or the serialized record value exceeds 4096 bytes.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested canonical record was not found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "The demo is intentionally offline or a required registered source is unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "type": "object",
                  "required": [
                    "status",
                    "message"
                  ],
                  "properties": {
                    "status": {
                      "const": "offline"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      }
    },
    "schemas": {
      "DemoRecord": {
        "type": "object",
        "required": [
          "namespace",
          "key",
          "value",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "namespace": {
            "type": "string",
            "maxLength": 64
          },
          "key": {
            "type": "string",
            "maxLength": 64
          },
          "value": {},
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "authorization": {
            "$ref": "#/components/schemas/AuthorizationSummary"
          },
          "auditEventId": {
            "type": "integer"
          }
        }
      },
      "AuthorizationSummary": {
        "type": "object",
        "required": [
          "subject",
          "authentication",
          "permissions",
          "scope"
        ],
        "properties": {
          "subject": {
            "type": "string"
          },
          "authentication": {
            "type": "string",
            "enum": [
              "anonymous",
              "bearer",
              "oidc",
              "oauth2",
              "saml2"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "operator",
              "microsoft",
              "google",
              "github"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "demo:read",
                "demo:write",
                "reporting:private",
                "reporting:write"
              ]
            }
          },
          "scope": {
            "type": "string",
            "enum": [
              "public",
              "visitor-sandbox",
              "caller-selected"
            ]
          }
        }
      },
      "RecordInput": {
        "type": "object",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "default": "public",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "key": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "value": {
            "x-max-serialized-bytes": 4096
          }
        },
        "additionalProperties": false
      },
      "RecordReplacement": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "default": "public",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
          },
          "key": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
            "description": "When supplied, must equal the key path parameter."
          },
          "value": {
            "x-max-serialized-bytes": 4096
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
